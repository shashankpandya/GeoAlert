# ===================================================
# GeoAlert — Root .gitignore
# ===================================================

# SECRETS — never commit
geoalert-v2/backend/.env

# Auto-generated by next dev — not project source code
geoalert-v2/frontend/AGENTS.md
geoalert-v2/frontend/CLAUDE.md
geoalert-v2/frontend/next-env.d.ts

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
.turbo/
out/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Note: .vscode/ is intentionally tracked (shared editor config)
# Note: .kiro/specs/ is intentionally tracked (feature specification docs)

# Build / test artefacts
geoalert-v2/frontend/playwright-report/
geoalert-v2/frontend/test-results/
geoalert-v2/frontend/coverage/
geoalert-v2/backend/.coverage
geoalert-v2/backend/htmlcov/
